# Copy this file to .env for local (non-Docker) runs:
#   cp .env.example .env
# Never commit the real .env - only this example file belongs in the repo.

# Postgres connection string.
# Inside docker compose the api service overrides this with host "db".
DATABASE_URL=postgres://newtonite:newtonite@localhost:5432/newtonite_ops

# HMAC secret for signing JWTs (HS256, 8h expiry). Use a long random value.
JWT_SECRET=replace-me-with-a-long-random-string

# HTTP port the API listens on.
PORT=3000
